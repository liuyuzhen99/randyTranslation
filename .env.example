# === Current Runtime (required at startup in Phase 0) ===
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
JOB_REPOSITORY_BACKEND=sqlalchemy
JOB_REPOSITORY_SQLITE_PATH=./data/jobs.db
PHASE2_SHADOW_WRITE_ENABLED=true
PHASE2_AUTO_CREATE_SCHEMA=false
PHASE2_RECONCILE_ENABLED=true
PHASE2_RECONCILE_REPORT_PATH=./data/reports/phase2-reconcile.json
PHASE2_RECONCILE_MAX_MISSING_JOBS=0
PHASE2_RECONCILE_MAX_JOB_FIELD_MISMATCHES=0
PHASE2_RECONCILE_MAX_INVALID_OUTBOX_PAYLOADS=0
PHASE2_RECONCILE_MAX_OUTBOX_PAYLOAD_MISMATCHES=0
PHASE2_OUTBOX_DISPATCH_ENABLED=false
# For Phase 2 you may also set JOB_REPOSITORY_BACKEND=sqlalchemy

# === Phase 6 Async Pipeline ===
PHASE6_ASYNC_PIPELINE_ENABLED=false
PHASE6_SERVICE_WORKER_ENABLED=true
PHASE6_SERVICE_WORKER_POLL_SECONDS=1.0
PHASE6_MAX_STAGE_ATTEMPTS=3
PHASE6_RETRY_BACKOFF_BASE_SECONDS=30

# === Phase 5 Media Storage ===
MEDIA_STORAGE_BACKEND=local
MEDIA_TEMP_ROOT=./data/media/temp
MEDIA_OUTPUT_ROOT=./data/media/output
ARTIFACT_TEMP_RETENTION_DAYS=1
# 0 keeps final artifacts indefinitely; set a positive value to expire and delete them via lifecycle job.
ARTIFACT_FINAL_RETENTION_DAYS=0
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
DEEPSEEK_TRANSLATION_MODEL=deepseek-chat
# Use one of these when YouTube requires authenticated yt-dlp requests.
# Examples: chrome, chrome:Default, safari, brave, edge
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=
# YouTube may require JS challenge solving. Example for macOS Homebrew Node:
YTDLP_JS_RUNTIMES=node:/opt/homebrew/bin/node
YTDLP_REMOTE_COMPONENTS=ejs:github

# === Current Service Integrations ===
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://localhost:8080/callback

# === Target Infra (phased rollout; placeholders for future phases) ===
DATABASE_URL=postgresql+psycopg://randy:Liuyuzhen9@localhost:5432/randy_translation
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=randy_translation
POSTGRES_USER=randy
POSTGRES_PASSWORD=Liuyuzhen9

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
VECTOR_REPOSITORY_BACKEND=sqlite
VECTOR_EMBEDDING_DIMENSION=384
QDRANT_COLLECTION_PREFIX=

# === Phase 9 Cutover Controls ===
PHASE9_CUTOVER_READ_SOURCE=legacy
PHASE9_SCHEMA_FREEZE_ENABLED=false
PHASE9_ROLLBACK_ENABLED=true
PHASE9_STABILITY_WINDOW_DAYS=7
PHASE9_SHADOW_TRAFFIC_ENABLED=false

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=randy-translation
S3_REGION=us-east-1

# Tencent COS (set MEDIA_STORAGE_BACKEND=cos to enable)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=randy-translation-1250000000
COS_REGION=ap-shanghai
COS_SCHEME=https
COS_ENDPOINT=
